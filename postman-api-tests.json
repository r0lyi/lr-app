{
  "info": {
    "name": "LR App API - JWT y KPIs",
    "description": "Coleccion para probar autenticacion JWT y endpoints internos de la plataforma.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "dni",
      "value": "00000000T"
    },
    {
      "key": "password",
      "value": "PruebaSegura123!"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Obtener token con DNI",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{dni}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/token/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.access) {",
              "  pm.collectionVariables.set('access_token', json.access);",
              "}",
              "if (json.refresh) {",
              "  pm.collectionVariables.set('refresh_token', json.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Refrescar access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/token/refresh/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            "refresh",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.access) {",
              "  pm.collectionVariables.set('access_token', json.access);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Verificar access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{access_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/token/verify/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            "verify",
            ""
          ]
        }
      }
    },
    {
      "name": "KPIs - Solicitudes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/dashboard/solicitudes/kpis/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "dashboard",
            "solicitudes",
            "kpis",
            ""
          ]
        }
      }
    },
    {
      "name": "KPIs - Usuarios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/dashboard/usuarios/kpis/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "dashboard",
            "usuarios",
            "kpis",
            ""
          ]
        }
      }
    },
    {
      "name": "Usuarios - Resumen por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/usuarios/{{user_id}}/resumen/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "usuarios",
            "{{user_id}}",
            "resumen",
            ""
          ]
        }
      }
    }
  ]
}
